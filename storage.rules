rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // ==========================================================
    // PRODUCT IMAGES
    // ==========================================================

    match /products/{allPaths=**} {

      // Storefront product images are public.
      allow read: if true;

      // Only users with product permission can upload/replace.
      // Enforce image type and 2 MB maximum at the server.
      allow create, update: if request.auth != null
        && firestore.get(
          /databases/(default)/documents/users/$(request.auth.uid)
        ).data.permissions.products == true
        && request.resource.size <= 2 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');

      // Only product managers can delete.
      allow delete: if request.auth != null
        && firestore.get(
          /databases/(default)/documents/users/$(request.auth.uid)
        ).data.permissions.products == true;
    }

    // ==========================================================
    // USER FILES
    // ==========================================================

    match /users/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null
        && request.auth.uid == userId;
    }

    // ==========================================================
    // DEFAULT DENY
    // ==========================================================

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}