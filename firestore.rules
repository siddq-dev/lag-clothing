rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================================
    // HELPERS
    // ==========================================================

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function currentUser() {
      return get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      );
    }

    function isSuperAdmin() {
      return signedIn()
        && currentUser().data.role == 'superAdmin';
    }

    function hasPermission(permission) {
      return signedIn()
        && currentUser().data.permissions[permission] == true;
    }

    // ==========================================================
    // USERS
    // ==========================================================

    match /users/{userId} {

      // Customer can read own account.
      // Authorized admins can read customer/admin records.
      allow read: if isOwner(userId)
        || hasPermission('customers')
        || hasPermission('admins');

      // Customer registration.
      allow create: if isOwner(userId)
        && request.resource.data.role == 'customer'
        && request.resource.data.status == true
        && request.resource.data.permissions.dashboard == false
        && request.resource.data.permissions.products == false
        && request.resource.data.permissions.orders == false
        && request.resource.data.permissions.customers == false
        && request.resource.data.permissions.inventory == false
        && request.resource.data.permissions.coupons == false
        && request.resource.data.permissions.analytics == false
        && request.resource.data.permissions.admins == false
        && request.resource.data.permissions.settings == false;

      // A customer cannot change:
      // - role
      // - permissions
      // - status
      //
      // Super Admin can manage user/admin records.
      //
      // Uses .get(field, default) instead of direct field access
      // so this rule doesn't crash-deny updates on legacy/partial
      // documents (e.g. accounts created before "permissions" and
      // "status" were required fields) that are missing one of
      // these keys entirely. Direct dot/bracket access on a
      // missing top-level field throws a rules evaluation error,
      // which Firestore reports as permission-denied for reasons
      // completely unrelated to authorization.
      allow update: if (
        isOwner(userId)
        && request.resource.data.role == resource.data.role
        && request.resource.data.get('permissions', null) ==
           resource.data.get('permissions', null)
        && request.resource.data.get('status', null) ==
           resource.data.get('status', null)
      ) || isSuperAdmin();

      allow delete: if false;

      // --------------------------------------------------------
      // USER ADDRESSES
      // --------------------------------------------------------

      match /addresses/{addressId} {
        allow read, create, update, delete: if isOwner(userId);
      }

      // --------------------------------------------------------
      // USER PAYMENT METHODS
      // --------------------------------------------------------

      match /payment_methods/{paymentMethodId} {
        allow read, create, update, delete: if isOwner(userId);
      }

      // --------------------------------------------------------
      // USER ACCOUNT SETTINGS
      // --------------------------------------------------------

      match /account_settings/{settingsId} {
        allow read, create, update, delete: if isOwner(userId);
      }

      // --------------------------------------------------------
      // USER NOTIFICATION SETTINGS
      // --------------------------------------------------------

      match /notification_settings/{settingsId} {
        allow read, create, update, delete: if isOwner(userId);
      }
    }

    // ==========================================================
    // PRODUCTS
    // ==========================================================

    match /products/{productId} {

      // Public storefront.
      allow read: if true;

      // Only users with product-management permission can
      // create/update/delete catalog products.
      allow create, update, delete: if hasPermission('products');
    }

    // ==========================================================
    // ORDERS
    // ==========================================================

    match /orders/{orderId} {

      // Customers can read only their own orders.
      // Staff with order permission can read all orders.
      allow read: if (
        signedIn()
        && resource.data.userId == request.auth.uid
      ) || hasPermission('orders');

      // Orders are created only by the createSecureOrder
      // Cloud Function (Admin SDK), never directly by clients.
      allow create: if false;

      // Order management belongs to authorized staff.
      allow update, delete: if hasPermission('orders');
    }

    // ==========================================================
    // CART
    // ==========================================================

    match /cart/{userId} {
      allow read, create, update, delete: if isOwner(userId);

      match /items/{itemId} {
        allow read, create, update, delete: if isOwner(userId);
      }
    }

    // ==========================================================
    // WISHLIST
    // ==========================================================

    match /customers/{userId}/wishlist/{itemId} {
      allow read, create, update, delete: if isOwner(userId);
    }

    // ==========================================================
    // COUPONS
    // ==========================================================

    match /coupon_codes/{couponId} {

      // Customers can read available coupons.
      allow read: if true;

      // Coupon management.
      allow create, update, delete: if hasPermission('coupons');
    }

    // ==========================================================
    // INVENTORY LOGS
    // ==========================================================

    match /inventory_logs/{logId} {
      allow read, create, update, delete: if hasPermission('inventory');
    }

    // ==========================================================
    // PAGE VISITS
    // ==========================================================

    match /page_visits/{visitId} {

      // Website analytics can record visits.
      allow create: if true;

      // Analytics dashboard access.
      allow read, update, delete: if hasPermission('analytics');
    }

    // ==========================================================
    // ANALYTICS SESSIONS
    // ==========================================================

    match /sessions/{sessionId} {

      // Client analytics session tracking.
      allow create, update: if true;

      // Analytics staff can inspect/delete sessions.
      allow read, delete: if hasPermission('analytics');
    }

    // ==========================================================
    // EVERYTHING ELSE
    // ==========================================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}